<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="{{ eleventy.generator }}" />
    <link rel="alternate" type="application/atom+xml" title="Atom Feed" href="/feed.xml" />
    <link rel="icon" href="/assets/images/site-favicon.svg" type="image/svg+xml" />
    {%- if fontCss %}
    <link rel="preconnect" href="{{ fontHost }}" crossorigin />
    <link href="{{ fontCss }}" rel="stylesheet" />
    {%- else %}
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=satoshi@400,401,700,701&display=swap"
      rel="stylesheet"
    />
    {%- endif %}
    <link rel="stylesheet" href="/styles/{{ stylesheet }}.css" />
    {%- if content contains 'class="demo' %}
    <link rel="stylesheet" href="/styles/demo.css" />
    {%- endif %}
    {%- unless standalone %}
    {% include "theme-script.liquid" %}
    {%- endunless %}
    {%- if page.url == "/" %}
    <script type="application/ld+json">{{ person | json }}</script>
    {%- endif %}
    {% include "analytics.liquid" %}
    {% include "seo-meta.liquid" %}
  </head>
  <body>
    {%- unless standalone %}
    {% include "site-header.liquid" %}
    {%- endunless %}
    {{ content }}
    {%- unless standalone %}
    {% include "footer.liquid" %}
    {%- endunless %}
    {%- if content contains 'class="codepen"' %}
    <script async src="https://static.codepen.io/assets/embed/ei.js"></script>
    {%- endif %}
  </body>
</html>
