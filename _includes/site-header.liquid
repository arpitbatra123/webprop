<header class="site-header">
  {%- comment %} Hidden until the theme script runs {% endcomment %}
  <button class="theme-switch" type="button" hidden>
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <path d="M10 2a8 8 0 0 0 0 16z" />
      <circle cx="10" cy="10" r="8" />
    </svg>
    <span class="theme-switch-label"></span>
  </button>
  {%- if page.url == "/" %}
  <h1 class="site-name">Arpit Batra</h1>
  {%- else %}
  <a class="site-name" href="/">Arpit Batra</a>
  {%- endif %}
  <nav aria-label="Main">
    <ul>
      <li><a href="/blog/"{% if page.url == "/blog/" or tags contains "posts" %} aria-current="page"{% endif %}>Blog</a></li>
      <li><a href="https://github.com/arpitbatra123">GitHub</a></li>
      <li><a href="https://www.linkedin.com/in/arpitbatra123">LinkedIn</a></li>
      <li><a href="mailto:arpitbatra123@gmail.com">Email</a></li>
    </ul>
  </nav>
</header>
