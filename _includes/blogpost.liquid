---
layout: base.liquid
stylesheet: blogpost
---

<main id="main">
  <header>
    <h1>{{ title }}</h1>
    <div class="post-meta">
      <time class="post-date" datetime="{{ date | date: "%Y-%m-%d" }}">{{ date | date: "%b %d %Y" }}</time>
      {% if updatedAt %}
      <span class="date-spacer">•</span>
      <div class="post-updated-date">
        <span>Updated</span>
        <time datetime="{{ updatedAt | date: "%Y-%m-%d" }}">{{ updatedAt | date: "%b %d %Y" }}</time>
      </div>
      {% endif %}
    </div>
    {% if date | isOlderThanYears %}
    <aside class="post-age-warning" role="note">
      This post is more than {{ warningThresholdYears }} years old. Some details, opinions, or context may be out of date.
    </aside>
    {% endif %}
  </header>
  {{ content }}
</main>
{%- if content contains 'class="demo' %}
<script>
  // Show each demo box's rendered width and padding, and keep it updated
  for (const demo of document.querySelectorAll(".demo")) {
    const box = demo.firstElementChild;
    const size = document.createElement("p");
    size.className = "demo-size";
    demo.append(size);

    new ResizeObserver(() => {
      const padding = getComputedStyle(box).paddingLeft;
      size.textContent = `Rendered width: ${box.offsetWidth}px (padding: ${padding})`;
    }).observe(box, { box: "border-box" });
  }
</script>
{%- endif %}
