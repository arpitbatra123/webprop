---
layout: base.liquid
stylesheet: blogpost
---

<header>
  <h2>Arpit Batra's <a href="/blog"> Blog</a></h2>
  <h1>{{ title }}</h1>
  <div class="post-meta">
    <time class="post-date" datetime="{{ date | date: "%Y-%m-%d" }}">{{ date | date: "%b %d %Y" }}</time>
    {% if updatedAt %}
    <span class="date-spacer">•</span>
    <div class="post-updated-date">
      <span>Updated</span>
      <time datetime="{{ updatedAt | date: "%Y-%m-%d" }}">{{ updatedAt | date: "%b %d %Y" }}</time>
    </div>
    {% endif %}
  </div>
  {% if date | isOlderThanYears %}
  <aside class="post-age-warning" role="note">
    This post is more than {{ warningThresholdYears }} years old. Some details, opinions, or context may be out of date.
  </aside>
  {% endif %}
</header>
<main id="main">
  {{ content }}
</main>
<footer>
</footer>
