---
permalink: blog/index.html
layout: base.liquid
stylesheet: blog
title: Arpit Batra's Blog
description: "Posts by Arpit Batra"
---

<main id="main">
  <h1 class="visually-hidden">Blog</h1>
  <ul class="posts">
    {% for post in collections.posts reversed %}
    <li class="post">
      <span class="post-title">
        <a href="{{ post.data.externalLink | default: post.url }}">{{ post.data.title }}</a>
      </span>
      <div class="post-date">
        {{ post.date | date: "%b %Y" }}
      </div>
    </li>
    {% endfor %}
  </ul>
</main>
