---
permalink: blog/index.html
layout: base.liquid
stylesheet: blog
title: Arpit Batra's Blog
---

<header>
  <h1>Arpit Batra's Blog</h1>
</header>
<main id="main" role="main">
  <ul class="posts">
    {% for post in collections.posts reversed %}
    <li class="post">
      {% if post.data.meta.hindiTitle %}
      <!-- Can contain a hindi specific font later -->
      <span class="post-title">
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </span>
      {% else %} {% if post.data.externalLink %}
      <span class="post-title">
        <a href="{{ post.data.externalLink }}">{{ post.data.title }}</a>
      </span>
      {% else %}
      <span class="post-title">
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </span>
      {% endif %} {% endif %}
      <div class="post-date">
        {{ post.date | date: "%b %Y" }}
      </div>
    </li>
    {% endfor %}
  </ul>
</main>
