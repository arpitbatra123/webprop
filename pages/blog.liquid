---
permalink: blog/index.html
layout: base.liquid
stylesheet: blog
title: Arpit Batra's Blog
---

<header>
  <h1>Arpit Batra's Blog</h1>
</header>
<main id="main" role="main">
  <ul class="posts">
    {% for post in collections.posts reversed %}
    <li class="post">
      <span class="post-title">
        <a href="{{ post.data.externalLink | default: post.url }}">{{ post.data.title }}</a>
      </span>
      <div class="post-date">
        {{ post.date | date: "%b %Y" }}
      </div>
    </li>
    {% endfor %}
  </ul>
</main>
