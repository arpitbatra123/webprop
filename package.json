{
  "name": "webprop",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build:sass": "sass styles:_site/styles --no-source-map --style=compressed --update",
    "watch:sass": "sass styles:_site/styles --update --watch",
    "watch:eleventy": "eleventy --serve",
    "build:eleventy": "eleventy",
    "dev": "npm-run-all build:sass --parallel watch:*",
    "build": "run-s build:sass build:eleventy",
    "og": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless --hide-scrollbars --virtual-time-budget=5000 --window-size=1200,630 --screenshot=assets/images/og-arpit-batra.png assets/images/og-arpit-batra.svg"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "markdown-it": "^15.0.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.105.1"
  },
  "devDependencies": {
    "@shikijs/markdown-it": "^4.5.0"
  }
}
