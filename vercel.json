{
  "trailingSlash": true,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/posts/best-of-2022/",
      "destination": "/bestof22/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
